# Copy this file to .env.local for local development.
# In production (Vercel), set these under Project Settings → Environment Variables instead.

# --- Supabase (required) ---
# Find these in Supabase: Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # "service_role" key — server-only, never expose to the browser

# --- Admin dashboard (required) ---
# Pick any username/password — this gates /admin with HTTP Basic Auth.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long-and-random

# --- Site URL (required for correct sitemap / OG tags) ---
NEXT_PUBLIC_SITE_URL=https://transparentchanges.com

# --- Analytics & ads (optional — leave blank until you have accounts) ---
NEXT_PUBLIC_GA_ID=                          # e.g. G-XXXXXXXXXX (GA4 Measurement ID)
NEXT_PUBLIC_GOOGLE_ADS_ID=                  # e.g. AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=    # e.g. AW-XXXXXXXXX/AbC-D_efG-h12
NEXT_PUBLIC_META_PIXEL_ID=                  # e.g. 1234567890123456
