# Committed on purpose (see .gitignore) — these are public, non-secret build-time
# values baked into every page's HTML anyway. Keeping them here means a
# production build always has them, without depending on the Cloudflare
# dashboard's build-variable configuration.
#
# Never add real secrets to this file (Supabase keys, admin password, API
# keys) — those belong only in .env.local (gitignored) and as Cloudflare
# Worker runtime secrets, not build-time vars.

NEXT_PUBLIC_SITE_URL=https://transparentchanges.com
